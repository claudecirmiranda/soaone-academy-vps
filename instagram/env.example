# Copie para .env e preencha. Nunca versione o .env nem o token.json.

# Token de longa duração do Instagram (60 dias). Gerado no painel do app da Meta (README, passo 3).
# O script renova sozinho a cada RENOVAR_DIAS e guarda o atual em token.json.
IG_TOKEN=

# Token do Facebook (EAA…) também funciona: aí IG_USER_ID é obrigatório e o script precisa de
# FB_APP_ID e FB_APP_SECRET (painel do app > Configurações > Básico) para trocar pelo token de 60 dias.
FB_APP_ID=
FB_APP_SECRET=

# ID da conta profissional do Instagram. Deixe vazio para usar "me" (a conta dona do token).
IG_USER_ID=

# Versão da API (deixe como está; troque só se a Meta descontinuar)
IG_API_VERSAO=v24.0

# Onde o nginx serve as mídias (pasta site/ig da VPS)
MIDIA_URL=https://academy.soaone.com.br/ig
MIDIA_DIR=../site/ig

# Endpoint público que diz quais módulos estão liberados (posts com "modulo" esperam por ele)
LIBERACAO_URL=https://soaone.com.br/api/v2/aulas

# Aviso no celular (opcional): instale o app ntfy e assine o tópico. Use um nome difícil de adivinhar.
NOTIFICAR_URL=

RENOVAR_DIAS=7
MAX_TENTATIVAS=4
ATRASO_MAX_HORAS=6
